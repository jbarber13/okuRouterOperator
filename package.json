{
  "name": "oku-router-operator",
  "private": true,
  "description": "Multisig and fee-collection operations for OkuRouter. Contracts are not built here -- see the okuRouter repo for deployment; this repo vendors the ABI/addresses it needs (see typechain-types/README and util/deploymentsRegistry.ts).",
  "dependencies": {
    "@gfxlabs/oku-chains": "1.13.1"
  },
  "scripts": {
    "test": "npx hardhat test test/base/*.ts",
    "test:fork-sweep": "FORK_CHAIN_ID=480 npx hardhat run scripts/testForkSweepWorldchain.ts",
    "test:fork-migration": "npx hardhat run scripts/testForkSafeMigration.ts",
    "sign-page": "node scripts/safeSignPage/serve.js",
    "check:sign-page": "node scripts/safeSignPage/check.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.9",
    "@nomicfoundation/hardhat-ethers": "3.0.9",
    "@nomicfoundation/hardhat-network-helpers": "1.0.13",
    "@types/chai": "4.3.19",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.8.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "chai": "4.5.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.13.0",
    "ethers": "^6.13.5",
    "globals": "^15.11.0",
    "hardhat": "2.25.0",
    "ts-node": "^10.9.2",
    "typescript": "5.0.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

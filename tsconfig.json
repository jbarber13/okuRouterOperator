{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "mocha"
    ]
  },
  "include": [
    "./tasks",
    "./util",
    "./scripts",
    "./test",
